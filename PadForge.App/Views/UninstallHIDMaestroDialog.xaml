<ui:FluentWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.UninstallHIDMaestroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Width="560" SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- The removal of HIDMaestro from the PC (#518), in the ConfirmDialog's
         chrome: ember tick and display-face title, the body, then a footer
         where Cancel holds the default and the initial focus. In front of
         the footer, what HIDMaestro's own preview found. -->
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource EmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText"
                       Text="{Binding HIDMaestroUninstall_Title, Source={x:Static strings:Strings.Instance}}"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap"
                   Text="{Binding HIDMaestroUninstall_Message, Source={x:Static strings:Strings.Instance}}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- usbip-win2 that its own installer put on the PC goes only when
             the user asks (HMUninstallOptions.IncludeUsbip). Changing it
             reads the PC again. -->
        <StackPanel Grid.Row="2" x:Name="UsbipPanel" Margin="0,12,0,0">
            <CheckBox x:Name="IncludeUsbipBox"
                      Content="{Binding HIDMaestroUninstall_IncludeUsbip, Source={x:Static strings:Strings.Instance}}"
                      Checked="IncludeUsbipBox_Changed" Unchecked="IncludeUsbipBox_Changed"/>
            <TextBlock Text="{Binding HIDMaestroUninstall_IncludeUsbipDesc, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" FontSize="12" Margin="28,2,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" x:Name="BusyPanel" Orientation="Horizontal" Margin="0,14,0,0">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding HIDMaestroUninstall_Reading, Source={x:Static strings:Strings.Instance}}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Nothing to remove, the programs that block the removal, or a
             preview that failed. -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Visibility="Collapsed"/>
            <ItemsControl x:Name="ProgramList" Margin="0,4,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Each item HIDMaestro found: what it is, where it is, and, for one
             that stays or could not be read, why. HIDMaestro writes these in
             English, as it writes its exception messages. -->
        <ListBox Grid.Row="5" x:Name="EntryList" MaxHeight="300" Margin="0,8,0,0"
                 Visibility="Collapsed"
                 ItemContainerStyle="{StaticResource EmberSelectListItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"/>
                        <TextBlock Text="{Binding Kind}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" MinWidth="90"
                    Content="{Binding Common_Refresh, Source={x:Static strings:Strings.Instance}}"
                    Click="RefreshButton_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelButton" MinWidth="90" Margin="0,0,8,0"
                        Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                        IsCancel="True" IsDefault="True"/>
                <Button x:Name="ActionButton" MinWidth="90" IsEnabled="False"
                        Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                        Style="{StaticResource EmberDestructiveButton}"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
